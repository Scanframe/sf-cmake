{
	"version": 8,
	"cmakeMinimumRequired": {
		"major": 3,
		"minor": 29,
		"patch": 0
	},
	"configurePresets": [
		{
			"name": ".tc-mingw",
			"description": "Toolchain for generic MinGW",
			"hidden": true,
			"cacheVariables": {
				"SF_COMPILER": {
					"type": "STRING",
					"value": "mingw"
				},
				"SF_QT_BIN_SUBDIR": {
					"type": "STRING",
					"value": "mingw_64/bin"
				}
			},
			"vendor": {
				"jetbrains.com/clion": {
					"toolchain": "MinGW"
				}
			}
		}
	]
}
