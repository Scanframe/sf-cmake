				},
				{
					"type": "build",
					"name": "gw-coverage"
				},
				{
					"type": "test",
					"name": "gw-coverage"
				}
			],
			"vendor": {
				"target_os": "GNU/Linux"
			}
		},
		{
			"name": "gw-release",
			"displayName": "Release GW",
