@startuml GitLab Pipeline
!theme plain

<style>
	root
	{
		FontName Arial
		FontSize 13
		'HorizontalAlignment Left
		BackgroundColor #white
	}
	title{
		FontStyle Bold
		FontSize 16
		FontColor #black
	}
	frame {
		FontColor Black
		LineColor Gray
		BackgroundColor #F9F9F9-#E9E9E9
		RoundCorner 10
		'HorizontalAlignment Left
	}
	rectangle {
		RoundCorner 10
		.event {BackgroundColor #77BC65-#069A2E}
		.gitlab-ci {BackgroundColor #FFDE59-#B47804}
		.job {BackgroundColor #D6EAF8-#2E86C1}
		.gitlab-ci1 {BackgroundColor #D5F5E3-#27AE60}
		.child-job {BackgroundColor #D5F5E3-#27AE60}
	}
	arrow { LineColor DarkRed; FontColor DarkBlue; LineThickness 1 }
	' Global Styles for the Legend Box
	legend, note {
		' Adds 15 pixels of breathing room inside the border
		Padding 8
		' Optional: Adds spacing outside the border
		Margin 5
		BackgroundColor #FEFFDD
	}
</style>

skinparam RankSep 10
skinparam NodeSep 15
'skinparam linetype ortho

title GitLab Merge Request and Release Pipeline

left to right direction
top to bottom direction

frame "Events" as events {
	rectangle "Merge request" <<event>> as mr
	rectangle "Protected branch" <<event>> as branch
	rectangle "Web / signal" <<event>> as web
}

frame "Parent pipeline" as parent {
	rectangle "check-env\nformat and environment" <<gitlab-ci>> as check
	rectangle "trigger child pipelines" <<gitlab-ci>> as trigger
	rectangle "coverage report" <<gitlab-ci>> as report
}

frame "Child build pipelines" as children {
	rectangle "MinGW\nWine" <<job-option>> as mingw
	rectangle "GNU x86_64\nLinux/Native" <<job>> as gnu
	rectangle "GNU aarch64\ncross-build" <<job>> as ga
	rectangle "GW \ncross-build" <<job>> as gw
	rectangle "MSVC\nWine" <<job>> as msvc
}

frame "Each child" as child {
	rectangle "configure" <<child-job>> as configure
	rectangle "build" <<child-job>> as build
	rectangle "CTest" <<child-job>> as test
	rectangle "CPack" <<child-job>> as pack
	rectangle "deploy rules" <<child-job>> as deploy
}

mr --> check
branch --> check
web -> check
check -> trigger
trigger --> gnu
trigger --> ga
trigger --> gw
trigger --> msvc
gnu --> configure
ga --> configure
gw --> configure
msvc --> configure
configure --> build
build -> test
test -> pack
pack -> deploy
test -> report : coverage child

note bottom of deploy {
Non-release branches
normally target develop.
Staging and stable are
environment/release-controlled.
}

' Keep each block internally vertical.
mr -[hidden]down-> branch
'branch -[hidden]down-> web
'check -[hidden]down-> trigger
'trigger -[hidden]down-> report
'gnu -[hidden]down-> ga
'ga -[hidden]down-> gw
'gw -[hidden]down-> msvc

' Arrange the four major blocks as two readable columns.
events -[hidden]right-> children
parent -[hidden]right-> child
events -[hidden]down-> parent
children -[hidden]down-> child

@enduml
